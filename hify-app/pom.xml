<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.hify</groupId>
        <artifactId>hify</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>hify-app</artifactId>
    <name>hify-app</name>
    <description>L4 启动模块：应用入口、全局配置（线程池 / MyBatis-Plus 插件 / Flyway）、集成测试与架构测试。无业务代码</description>

    <!--
      依赖矩阵（CLAUDE.md 2.2）：hify-app → 全部。
      这是唯一被打成可执行 jar 的模块；数据库驱动与 Flyway 也只在此声明——
      它们是「部署形态」的一部分，不属于任何业务模块。

      注意 Flyway 迁移脚本本身仍分散在各模块的
      hify-{module}/src/main/resources/db/migration/ 下（CLAUDE.md 5.8），
      打包后合并到同一个 classpath 路径，由 Flyway 按时间戳式版本号统一排序执行。
    -->
    <dependencies>
        <!-- ===== 八个业务模块全量聚合 ===== -->
        <dependency>
            <groupId>com.hify</groupId>
            <artifactId>hify-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.hify</groupId>
            <artifactId>hify-provider</artifactId>
        </dependency>
        <dependency>
            <groupId>com.hify</groupId>
            <artifactId>hify-agent</artifactId>
        </dependency>
        <dependency>
            <groupId>com.hify</groupId>
            <artifactId>hify-knowledge</artifactId>
        </dependency>
        <dependency>
            <groupId>com.hify</groupId>
            <artifactId>hify-mcp</artifactId>
        </dependency>
        <dependency>
            <groupId>com.hify</groupId>
            <artifactId>hify-chat</artifactId>
        </dependency>
        <dependency>
            <groupId>com.hify</groupId>
            <artifactId>hify-workflow</artifactId>
        </dependency>

        <!-- ===== 运行期基础设施 ===== -->
        <!-- MySQL 8.x 驱动 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Flyway 数据库版本管理。核心包用 compile：可能需要写 FlywayConfigurationCustomizer -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <!-- Flyway 10 起 MySQL 支持被拆成独立模块，缺少会报「Unsupported Database: MySQL」 -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ===== 测试 ===== -->
        <!-- 架构测试（CLAUDE.md 12.3）：校验 2.2 的依赖方向、2.3 的包白名单、
             4.1 的分层调用规则、4.4 的 @Transactional 位置。
             放在 hify-app 是因为只有它的 classpath 上同时有全部八个模块 -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 版本与 repackage 执行配置继承自父 pom 的 pluginManagement -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
